.DS_Store
*.swp
*.swo
.idea/
.vscode/
node_modules/
__pycache__/
*.pyc

# Next.js build output
.next/
out/
next-env.d.ts

# Node-client subproject build output
node-client/dist/

# Local databases and env (MVP uses SQLite locally)
prisma/dev.db
prisma/dev.db-journal
prisma/migrations/dev.db
.env
.env.local
.env.*.local

# Local-only notes (deployment playbooks, scratch, secrets) — never pushed
*.local.md
*.local.txt
.private/

# Operational data (real candidate names, DM drafts, CRM) — never pushed
outreach/

# Runtime invocation events — local-only flywheel data
/runtime/invocations.jsonl
/runtime/_outbox.jsonl

# OMW server SQLite (Stage 3) — never committed; deployed to /opt/om-world/server
/server/omw_server.db
/server/*.log
/server/.env
/server/venv/

# Pattern-level invocation logs — local data, not Pattern definitions
patterns/**/invocations.jsonl
patterns/**/invocations.server.jsonl

# Pattern evolution proposals — auto-generated daily, local-only review queue
/runtime/pattern_evolution/
